{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "work-side",
              "type": "column",
              "size": {
                "px": 340
              },
              "min": 44,
              "max": 640,
              "gap": 0,
              "children": [
                {
                  "id": "side-bar",
                  "type": "block",
                  "size": {
                    "px": 40
                  },
                  "min": 40,
                  "content": {
                    "mod": "hermes",
                    "props": {
                      "node": "work-side"
                    }
                  }
                },
                {
                  "id": "side-prs",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 84,
                  "content": {
                    "mod": "agent-prs",
                    "props": {
                      "node": "work-side"
                    }
                  }
                },
                {
                  "id": "side-jira",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 84,
                  "content": {
                    "mod": "jira-tickets",
                    "props": {
                      "node": "work-side",
                      "site": "{{settings.jira.site}}",
                      "space": "{{settings.work.space}}",
                      "workdir": "{{settings.work.repos}}",
                      "notes": "{{settings.work.notes}}"
                    }
                  }
                }
              ],
              "background": "background",
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "divider": {
                "width": 1,
                "color": "border"
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              }
            },
            {
              "id": "status-refresh",
              "type": "block",
              "size": {
                "px": 112
              },
              "content": {
                "mod": "hermes",
                "props": {
                  "bar": true,
                  "panel": "work-side"
                }
              }
            },
            {
              "id": "status-daily",
              "type": "block",
              "size": {
                "px": 100
              },
              "content": {
                "mod": "daily-setup",
                "props": {
                  "bar": true,
                  "panel": "work-side",
                  "daily": {
                    "profile": "{{settings.aws.profile}}",
                    "region": "{{settings.aws.region}}",
                    "account": "{{settings.aws.account}}",
                    "domain": "{{settings.aws.codeartifact_domain}}"
                  }
                }
              }
            },
            {
              "id": "status-usage",
              "type": "block",
              "size": {
                "px": 120
              },
              "content": {
                "mod": "claude-usage",
                "props": {
                  "bar": true,
                  "panel": "work-side"
                }
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
